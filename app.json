{
  "expo": {
    "name": "Mori",
    "slug": "mori",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/mori_icon.png",
    "scheme": "mori",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F3EC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.getmori.mori",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F3EC"
      },
      "package": "com.mori.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F3EC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportUrl": "https://getmori.app/support",
      "privacyUrl": "https://getmori.app/privacy",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0d817669-e2da-4a4a-b807-609d0e9a8354"
      }
    }
  }
}
