{
  "expo": {
    "name": "Mori",
    "slug": "mori",
    "version": "5.0.0",
    "orientation": "portrait",
    "icon": "./assets/mori_icon.png",
    "scheme": "mori",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F3EC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.getmori.mori",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F3EC"
      },
      "package": "com.mori.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F3EC"
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mori uses your photo library to add images to recipes you create and your profile picture."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Mori needs photo library access to save badge cards and recipe screenshots.",
          "savePhotosPermission": "Mori needs permission to save badge cards and recipe screenshots to your Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@sentry/react-native",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "mori-2g"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportUrl": "https://getmori.app/support",
      "privacyUrl": "https://getmori.app/privacy",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0d817669-e2da-4a4a-b807-609d0e9a8354"
      }
    }
  }
}
