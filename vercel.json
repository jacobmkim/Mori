{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/taste-notifications",
      "schedule": "0 9 1 * *"
    },
    {
      "path": "/api/cron/streak-reminders",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/creator-milestones",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/community-enrichment",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/leftover-reminders",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/cook-reminders",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/winback-reminders",
      "schedule": "0 17 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/verify-email", "destination": "/verify-email.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/r/:id", "destination": "/api/recipe-page?id=:id" }
  ]
}
